# Supabase 專案 URL（client/server 共用；URL 本來就是公開資訊）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# 瀏覽器端金鑰（publishable key，sb_publishable_...；本地值見 supabase status）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase status 的 Publishable key>
# 伺服器端金鑰（secret key，sb_secret_...，對應 DB 的 service_role 權限；勿放進任何 NEXT_PUBLIC_*）
SUPABASE_SECRET_KEY=<supabase status 的 Secret key>

# Cron 輪詢路由的內部 token（/api/poll/services 的 Bearer）
CRON_SECRET=<任意隨機字串>

# Discord 通知（選填）：全域 fallback webhook 與 dashboard 連結
DISCORD_WEBHOOK_URL=
APP_URL=

# Google OAuth 憑證不放這裡——本地放 supabase/.env（供 config.toml env() 替換，gitignored），
# hosted 在 Supabase dashboard 的 Auth Provider 設定。

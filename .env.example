# 伺服器端 Supabase 連線（新制 secret key，sb_secret_...；勿放進任何 NEXT_PUBLIC_*）
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<supabase status 的 Secret key>

# 瀏覽器端 Supabase（新制 publishable key，sb_publishable_...；本地值見 supabase status）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase status 的 Publishable key>

# Cron 輪詢路由的內部 token（/api/poll/services 的 Bearer）
CRON_SECRET=<任意隨機字串>

# Discord 通知（選填）：全域 fallback webhook 與 dashboard 連結
DISCORD_WEBHOOK_URL=
APP_URL=

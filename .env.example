# 伺服器端 Supabase 連線（secret key，sb_secret_...，對應 DB 的 service_role 權限；勿放進任何 NEXT_PUBLIC_*）
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=<supabase status 的 Secret key>

# 瀏覽器端 Supabase（publishable key，sb_publishable_...；本地值見 supabase status）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase status 的 Publishable key>

# Cron 輪詢路由的內部 token（/api/poll/services 的 Bearer）
CRON_SECRET=<任意隨機字串>

# Discord 通知（選填）：全域 fallback webhook 與 dashboard 連結
DISCORD_WEBHOOK_URL=
APP_URL=
